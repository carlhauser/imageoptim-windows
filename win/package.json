{
  "name": "imageoptim-windows",
  "productName": "ImageOptim",
  "version": "0.2.0",
  "description": "Windows front-end for the ImageOptim lossless image optimizers",
  "license": "GPL-2.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win --x64 --publish never",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.imageoptim.windows",
    "productName": "ImageOptim",
    "copyright": "ImageOptim contributors",
    "publish": [
      {
        "provider": "github",
        "owner": "carlhauser",
        "repo": "imageoptim-windows",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*",
          "!bin/.gitkeep"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "png",
        "name": "PNG image",
        "role": "Editor"
      },
      {
        "ext": "jpg",
        "name": "JPEG image",
        "role": "Editor"
      },
      {
        "ext": "jpeg",
        "name": "JPEG image",
        "role": "Editor"
      },
      {
        "ext": "gif",
        "name": "GIF image",
        "role": "Editor"
      },
      {
        "ext": "svg",
        "name": "SVG image",
        "role": "Editor"
      },
      {
        "ext": "webp",
        "name": "WebP image",
        "role": "Editor"
      },
      {
        "ext": "avif",
        "name": "AVIF image",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ImageOptim",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
